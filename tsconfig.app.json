{
    "compilerOptions": {
        "target": "ESNext",
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "types": ["vite/client"],
        "paths": { "@gnikolaos/*": ["./src/*"], "@test/*": ["./test/*"] }
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.js"]
}
